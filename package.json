{
  "name": "releaselens",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "rl": "tsx apps/cli/src/index.ts",
    "bootstrap": "pnpm rl bootstrap",
    "observe": "pnpm rl observe --all",
    "discover": "pnpm rl discover --all",
    "refresh-community": "pnpm rl refresh-community --recent 72h",
    "validate-data": "pnpm rl validate-data",
    "validate-public": "pnpm rl validate-public",
    "build-public": "pnpm rl build-public && pnpm --filter @releaselens/web build",
    "build": "pnpm run build-public",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . --max-warnings=0",
    "e2e": "playwright test",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@next/eslint-plugin-next": "^15.5.24",
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.51.1",
    "@types/node": "^22.13.4",
    "eslint": "^9.21.0",
    "globals": "^15.15.0",
    "prettier": "^3.5.2",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.8"
  }
}
